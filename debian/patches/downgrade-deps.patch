diff --git a/Cargo.toml b/Cargo.toml
index a698cc1..bf425f5 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -21,11 +21,11 @@ rust-version = "1.74.0"
 license = "Apache-2.0 OR BSD-3-Clause"
 
 [workspace.dependencies]
